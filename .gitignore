# IPython
profile_default/
ipython_config.py

# pyenv
#   For a library or app, you might want to share your .python-version.
#   It makes the version of Python explicit.
#   Only uncomment if you are using pyenv and want to share.
#.python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms/versions, it may cause conflict.
#   Only uncomment if you want to lock the dependencies.
#Pipfile.lock

# poetry
#   poetry.lock is usually committed.
#poetry.lock

# pdm
#   pdm.lock is usually committed.
#pdm.lock

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath vars
*.sage.py

