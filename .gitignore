# Pyinstaller
#  Usually these files are written by a python script, before or during the
#  link stage. They contain code or binary to be included in a final executable.
#  Don't commit them unless they are part of your build process.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

